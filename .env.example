# Environment configuration for pflaenzli_backend.
# Copy to `.env` and adjust. `.env` is gitignored; never commit real secrets.
# All variables below are REQUIRED — settings.py has no defaults, so the app fails to
# start if any is missing.

# --- Development example values ---

# Debug pages + verbose errors. NEVER true in production.
DEBUG=True

# Generate a real one for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-i2vk@*mq@#paxolpjih2y#mm0&-3+iizm_@gs*efa%z59)wzdr

# Comma-separated. Production: the server IP / domain (and ngrok host if used).
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, scheme required. Production: the deployed frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Whether the backend actually talks to the Arduino over HTTP.
# Dev without hardware: False (pump/config calls are no-ops). Production: True.
ARDUINO_ENABLED=False

# The Arduino's address on the network (used only when ARDUINO_ENABLED=True).
ARDUINO_ADDRESS=192.168.68.112

# healthchecks.io dead-man's switch ping URL. Empty disables monitoring (dev/no hardware);
# production: paste the check's ping URL. The Pi-liveness timeout (a dead Pi can't ping) is
# the check's period + grace in the healthchecks.io UI (≈ 30 min + 30 min → alert in ~1 h).
HEALTHCHECKS_URL=

# Alert if the Arduino hasn't posted a moisture reading in this many minutes.
HC_ARDUINO_STALE_MINUTES=60

# Alert if the last fired scheduled pump action isn't confirmed by the Arduino reporting the
# pump on within this many minutes.
HC_PUMP_CONFIRM_MINUTES=15

# Only ping healthchecks once every N minutes (tick runs every minute). Keeps the
# healthchecks log readable. The check's period in the UI must be >= this value.
HC_PING_INTERVAL_MINUTES=10

# Deployment location: used for the ET0 (Open-Meteo) fetch and all local-time reasoning.
# Set the real values in production; these placeholders are non-identifying.
LATITUDE=0.0
LONGITUDE=0.0
LOCAL_TIMEZONE=UTC
